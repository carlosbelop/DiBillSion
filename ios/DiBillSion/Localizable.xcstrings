            "value": "Alguien de este gasto ya no participa en gastos nuevos."
          }
        }
      }
    },
    "Something in the form isn’t valid.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay algún dato del formulario que no es válido."
          }
        }
      }
    },
    "Split equally": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir a partes iguales"
