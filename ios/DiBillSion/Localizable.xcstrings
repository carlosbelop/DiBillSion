    },
    "Takes part in new expenses": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Participa en gastos nuevos"
          }
        }
      }
    },
    "Tap people to choose who shares each item. Everyone shares it until you do.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca a las personas para elegir quién comparte cada artículo. Mientras no lo hagas, lo comparten todos."
          }
        }
      }
    },
    "That invite link isn’t valid any more. Ask for a new one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese enlace de invitación ya no es válido. Pide uno nuevo."
          }
        }
      }
    },
    "That item no longer exists.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese elemento ya no existe."
          }
        }
      }
    },
    "That person isn’t in this group.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa persona no está en este grupo."
          }
        }
      }
    },
    "The exchange rate must be a number greater than zero.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de cambio debe ser un número mayor que cero."
          }
        }
      }
    },
    "The invite link is off. Inviting again creates a new link.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de invitación está desactivado. Si invitas de nuevo se crea uno nuevo."
          }
        }
      }
    },
    "The receipt reader isn’t responding. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lector de tickets no responde. Prueba de nuevo en un momento."
          }
        }
      }
    },
    "The server couldn’t handle that right now. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha podido atenderlo ahora. Inténtalo de nuevo en un momento."
          }
        }
      }
    },
    "The split doesn’t add up. Check the amounts and who is included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reparto no cuadra. Revisa los importes y quién participa."
          }
        }
      }
    },
    "This person already appears in expenses, so they can’t be removed. Deactivate them instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta persona ya aparece en gastos y no se puede quitar. Desactívala en su lugar."
